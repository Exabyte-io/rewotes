&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   wf_collect       = .true.
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './reference'
   prefix           = 'si'
   pseudo_dir       = './reference/pseudo'
/
&SYSTEM
   nbnd             = 8
   ecutwfc          = 40
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-13
   mixing_beta      = 0.7
   diagonalization  = 'david'
/
&IONS
/
&CELL
/

ATOMIC_SPECIES
Si 28.085 Si-PBE.upf

K_POINTS automatic
26 26 26  0 0 0

CELL_PARAMETERS angstrom
-2.71520825606202 0.00000000000000 2.71520825606202
0.00000000000000 2.71520825606202 2.71520825606202
-2.71520825606202 2.71520825606202 0.00000000000000

ATOMIC_POSITIONS angstrom
Si 0.0000000000 0.0000000000 0.0000000000 
