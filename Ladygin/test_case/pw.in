 &control
    calculation     = 'scf'
    prefix          = 'si'
    restart_mode    = 'from_scratch'
    wf_collect      = .true.
    pseudo_dir      = './'
    outdir          = './'
    tprnfor         = .true.
    tstress         = .true.
 /
 &system
    ibrav           = 2
    celldm(1)       = 10.262 
    nat             = 2
    ntyp            = 1
    ecutwfc         = 40.0
    nbnd            = 8
 /
 &electrons
    diagonalization = 'david'
    mixing_beta     = 0.7
    conv_thr        = 1.0d-13
 /

ATOMIC_SPECIES
  Si  28.0855     Si-PBE.upf
ATOMIC_POSITIONS crystal
Si    0.00  0.00   0.00
Si   -0.25  0.75  -0.25
K_POINTS automatic
18 18 18 0 0 0