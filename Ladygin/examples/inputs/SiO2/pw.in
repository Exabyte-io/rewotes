&control
  calculation = 'scf'
  prefix      = 'sio2'
  outdir      = '/tmp/'
  pseudo_dir  = '../pseudos/'
  verbosity   = 'high'
  wf_collect  = .true.
/

&system
  ibrav = 0
  nat = 6
  ntyp = 2
  ecutwfc = 60
  ecutrho = 244
/

&electrons
  mixing_mode = 'plain'
  mixing_beta = 0.7
  conv_thr = 1.0e-13
/

