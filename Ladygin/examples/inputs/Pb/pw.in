&CONTROL
  calculation= 'scf'
  restart_mode= 'from_scratch'
  prefix= 'pb'
  outdir= '/tmp/'
  pseudo_dir= '../pseudos/'
/

&SYSTEM
  ibrav= 2
  celldm(1) = 9.354144
  nat= 1
  ntyp= 1
  ecutwfc= 50
  ecutrho= 500
  occupations= 'smearing'
  smearing= 'gaussian'
  degauss= 0.01
/

&ELECTRONS
  conv_thr= 1e-13
/

ATOMIC_SPECIES
  Pb 207.2 Pb.pbe-dn-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (alat)
  Pb 0.00 0.00 0.00

K_POINTS (automatic)
  10 10 10 0 0 0
