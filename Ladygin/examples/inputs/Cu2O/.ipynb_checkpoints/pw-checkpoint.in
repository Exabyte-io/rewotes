&control
  calculation = 'scf'
  prefix      = 'Cu2O'
  outdir      = '/tmp/'
  pseudo_dir  = '../pseudos/'
  verbosity   = 'high'
  wf_collect  = .true.
/

&system
  ibrav = 1
  celldm(1) = 8.1027922452
  nat = 6
  ntyp = 2
  ecutwfc = 60
  ecutrho = 244
/

&electrons
  mixing_mode = 'plain'
  mixing_beta = 0.7
  conv_thr = 1.0e-13
/

ATOMIC_SPECIES
  Cu 63.546 Cu.pbe-dn-kjpaw_psl.1.0.0.UPF
  As 15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS
Cu 0.250000 0.250000 0.750000
Cu 0.750000 0.250000 0.250000
Cu 0.250000 0.750000 0.250000
Cu 0.750000 0.750000 0.750000
O 0.500000 0.500000 0.500000
O 0.000000 0.000000 0.000000


K_POINTS {automatic}
  8 8 8 0 0 0
